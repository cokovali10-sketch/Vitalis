{
    "schemaVersion": 1,
    "id": "vitalis",
    "version": "${version}",
    "name": "Vitalis",
    "description": "Client HUD mod: health bars, enchantment helper, target info, armor durability, potion timers, compact overlay",
    "authors": [
        "Mort1n"
    ],
    "contact": {
        "homepage": "https://github.com/cokovali10-sketch/Vitalis",
        "sources": "https://github.com/cokovali10-sketch/Vitalis"
    },
